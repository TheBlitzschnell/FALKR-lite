# Postgres connection string.
DATABASE_URL=postgres://falkr:falkr@localhost:5432/falkr

# Set to 1 when connecting through PgBouncer or another transaction-mode
# pooler. Disables the prepared-statement cache, which a transaction pooler
# would otherwise break intermittently under load.
DATABASE_TRANSACTION_POOLER=0

# Address the HTTP API binds to.
FALKR_BIND=0.0.0.0:8080

# Development credentials. The API resolves a bearer token to a tenant
# server-side; these two wire up a single token for local use.
# Do not use this configuration in production — implement TenantResolver
# against your real identity provider instead.
FALKR_DEV_TOKEN=dev-token-change-me
FALKR_DEV_TENANT_ID=00000000-0000-0000-0000-000000000001

# Logging.
RUST_LOG=info,sqlx=warn
